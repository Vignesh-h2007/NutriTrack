<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Personalized Nutrition Management System</display-name>

  <!-- ══════════════════════════════════════════════════════
       FILTERS
       ══════════════════════════════════════════════════════ -->

  <filter>
    <filter-name>EncodingCorsFilter</filter-name>
    <filter-class>com.nutrition.filter.EncodingCorsFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>EncodingCorsFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.nutrition.filter.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>

  <!-- ══════════════════════════════════════════════════════
       SERVLETS
       ══════════════════════════════════════════════════════ -->

  <servlet>
    <servlet-name>AuthServlet</servlet-name>
    <servlet-class>com.nutrition.controller.AuthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/api/auth/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>UserServlet</servlet-name>
    <servlet-class>com.nutrition.controller.UserServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UserServlet</servlet-name>
    <url-pattern>/api/user/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>FoodServlet</servlet-name>
    <servlet-class>com.nutrition.controller.FoodServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FoodServlet</servlet-name>
    <url-pattern>/api/food/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>MealServlet</servlet-name>
    <servlet-class>com.nutrition.controller.MealServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MealServlet</servlet-name>
    <url-pattern>/api/meal/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>WorkoutServlet</servlet-name>
    <servlet-class>com.nutrition.controller.WorkoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>WorkoutServlet</servlet-name>
    <url-pattern>/api/workout/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>TrackingServlet</servlet-name>
    <servlet-class>com.nutrition.controller.TrackingServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>TrackingServlet</servlet-name>
    <url-pattern>/api/track/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ReportServlet</servlet-name>
    <servlet-class>com.nutrition.controller.ReportServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReportServlet</servlet-name>
    <url-pattern>/api/report/*</url-pattern>
  </servlet-mapping>

  <!-- ══════════════════════════════════════════════════════
       SESSION CONFIG
       ══════════════════════════════════════════════════════ -->
  <session-config>
    <session-timeout>480</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- ══════════════════════════════════════════════════════
       WELCOME FILES
       ══════════════════════════════════════════════════════ -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <!-- ══════════════════════════════════════════════════════
       ERROR PAGES
       ══════════════════════════════════════════════════════ -->
  <error-page>
    <error-code>404</error-code>
    <location>/error.html</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/error.html</location>
  </error-page>

</web-app>
